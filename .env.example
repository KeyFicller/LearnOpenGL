# 复制成 .env 再填自己的值。每一侧都按 OpenAI 兼容格式描述，
# play.py 不认识任何厂商，只读下面这些。
#
# PROVIDER + MODEL 就是这一侧的身份：日志标签用它，长期记忆目录也用它，
# 形如 .output/chess/memory/<provider>:<model>/。取什么名字都行。
# EXTRA_BODY 是合并进每次请求的 JSON，用来开关思考等厂商私有参数；
# EXTRA_BODY_NOTHINK 在关掉思考时替换它（超时重试用）。换厂商时这两行要一起改，
# 否则会把上一家的字段发给新端点。没有这类参数就整行留空。
#
# 长这样：
#   CHESS_RED_PROVIDER=some-vendor
#   CHESS_RED_MODEL=some-model
#   CHESS_RED_BASE_URL=https://api.example.com/v1
#   CHESS_RED_API_KEY=sk-your-key
#   CHESS_RED_EXTRA_BODY={"enable_thinking":true}
#   CHESS_RED_EXTRA_BODY_NOTHINK={"enable_thinking":false}

CHESS_RED_PROVIDER=
CHESS_RED_MODEL=
CHESS_RED_BASE_URL=
CHESS_RED_API_KEY=
CHESS_RED_EXTRA_BODY=
CHESS_RED_EXTRA_BODY_NOTHINK=

CHESS_BLACK_PROVIDER=
CHESS_BLACK_MODEL=
CHESS_BLACK_BASE_URL=
CHESS_BLACK_API_KEY=
CHESS_BLACK_EXTRA_BODY=
CHESS_BLACK_EXTRA_BODY_NOTHINK=

# Shader Editor 的对话面板（scripts/shader_agent/chat.py）不走上面那套：
# 它固定用 DeepSeek，只读下面三个变量。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

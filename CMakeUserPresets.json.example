{
  "version": 6,
  "configurePresets": [
    {
      "name": "local",
      "inherits": "default",
      "description": "Machine-local. Replace CPPREF_LLVM_ROOT with your clang-p2996 install prefix (the one containing bin/clang++, include/c++/v1/meta and lib/libc++.dylib). Optionally set LEARNOPENGL_OCCT_BUILD_DIR to your OCCT build tree (contains OpenCASCADETargets.cmake); leave empty to keep OCCT off. To fetch through a git mirror, add GIT_CONFIG_COUNT / GIT_CONFIG_KEY_<n> = url.<mirror>.insteadOf / GIT_CONFIG_VALUE_<n> = <github url> entries here.",
      "environment": {
        "CPPREF_LLVM_ROOT": "/path/to/llvm-p2996"
      },
      "cacheVariables": {
        "LEARNOPENGL_OCCT_BUILD_DIR": ""
      }
    }
  ],
  "buildPresets": [
    {
      "name": "local",
      "configurePreset": "local"
    }
  ]
}
